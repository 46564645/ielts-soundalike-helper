{
  "manifest_version": 3,
  "name": "听写辨音助手",
  "version": "2.7.1",
  "description": "雅思听写与精听辅助：辨音对比、口语词组提取、发音收藏及 DeepSeek 解释。",
  "permissions": ["storage", "activeTab", "tts"],
  "host_permissions": [
    "https://ielts.itongzhuo.com/*",
    "https://www.idictation.cn/*",
    "https://ai-oss3.oss-cn-shenzhen.aliyuncs.com/*",
    "https://api.datamuse.com/*",
    "https://api.deepseek.com/*",
    "https://dict.youdao.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.idictation.cn/*"],
      "js": ["page-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ielts.itongzhuo.com/*",
        "https://www.idictation.cn/*"
      ],
      "js": ["lib/phonetics.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["audio/phonemes/kk/*.mp3"],
      "matches": ["https://ielts.itongzhuo.com/*", "https://www.idictation.cn/*"]
    }
  ],
  "action": {
    "default_title": "听写辨音助手",
    "default_popup": "popup.html"
  },
  "options_page": "comparison.html"
}
